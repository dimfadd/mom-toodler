# Chat assistant (Claude). Without a key the chat uses simple on-device rules.
ANTHROPIC_API_KEY=

# Optional: model for the chat. Default claude-opus-5-5; claude-haiku-5-5 is much cheaper.
CHAT_MODEL=

# Optional: chat messages per IP per day (default 60).
CHAT_DAILY_LIMIT=

# Optional: Midtrans or Xendit payment link for the founding member offer.
# Empty: the pricing button opens the app instead.
NEXT_PUBLIC_PREORDER_URL=
