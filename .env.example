# Where waitlist sign-ups are sent (for example a Google Apps Script web app that writes to Google Sheets).
# Leave empty to store them in .data/waitlist.jsonl on the server.
WAITLIST_WEBHOOK_URL=

# Midtrans or Xendit payment link for the founding member pre-order.
# Leave empty and the pre-order button opens the waitlist form instead.
NEXT_PUBLIC_PREORDER_URL=
